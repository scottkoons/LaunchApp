{
  "name": "launch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "test": "tsx --test tests/model.test.ts tests/store.test.ts tests/sync.test.ts tests/reminders.test.ts tests/image-view.test.ts tests/capture.test.ts tests/agent-mcp.test.ts tests/trash.test.ts tests/phone-alerts.test.ts tests/notification-clock.test.ts tests/reference-import.test.ts tests/report-notes.test.ts tests/capture-flow.test.ts tests/appearance.test.ts tests/review-fixes.test.ts",
    "test:api": "tsx --test tests/api.test.ts tests/trash-api.test.ts",
    "test:playback": "tsx --test tests/file-playback-api.test.ts",
    "test:sync:api": "tsx --test tests/sync-api.test.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check",
    "deadcode": "knip",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run deadcode && npm test",
    "test:pdf": "tsx tests/pdf-fixture.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@block65/webcrypto-web-push": "^2.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "dompurify": "^3.4.15",
    "drizzle-orm": "0.45.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "1.31.0",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.6",
    "@cloudflare/workers-types": "5.20260908.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "fake-indexeddb": "^6.2.5",
    "knip": "^6.35.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.130.0"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
